<?xml version="1.0" encoding="utf-8"?>
<!-- Repository-local package sources, so builds do not depend on machine-wide NuGet settings
     (a missing offline source such as "C:\Program Files (x86)\Microsoft SDKs\NuGetPackages\" fails restore with NU1301). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
